{
  "name": "heiman_dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "HEIMAN device cards for Home Assistant, Zigbee2MQTT and ZHA",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "catalog:update": "node --use-env-proxy scripts/update-catalog.mjs"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
